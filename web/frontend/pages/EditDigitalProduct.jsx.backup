    const toggleLicenseInput = () => {
        if (selectedLicenseTab === 1) {
            const newLicense = {
                title: licenseTitle,
                licenseType: value,
                prefix: prefix,
                codeLength: codeLength,
                suffix: suffix,
                totalCodes: totalCodes,
                licenseFiles:
                    selectedManualLicenseTab === 0 ? licenseFiles : [],
                pasteKeysValue:
