        (index, type) => {
            if (type === "files") {
                setFiles((files) => {
                    let newFiles = [...files];
                    newFiles.splice(index, 1);
                    return newFiles;
                });
            } else if (type === "orders") {
                setOrders((orders) => {
                    let newOrders = [...orders];
                    newOrders.splice(index, 1);
                    return newOrders;
                });
            }
        },
        [setFiles, setOrders]
    );

